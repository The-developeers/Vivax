# Conexão com o banco (deve bater com o docker-compose.yml)
DATABASE_URL="postgresql://viva_user:viva_password@localhost:5432/viva_plus?schema=public"

# Chave usada para assinar os tokens JWT (troque por uma string aleatória longa)
JWT_SECRET="troque_por_uma_string_secreta_aqui"

# Porta em que o servidor Node vai rodar
PORT=3333

# URL do frontend, liberada no CORS
FRONTEND_URL="http://localhost:3000"