generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id String @id @default(uuid())
    name String
    username String @unique
    email String @unique
    phone String
    password String
    type UserType @default(COMMON)

    // Preenchidos apenas para type = ENTREPRENEUR
    address String?
    addressNumber String?
    complement String?
    city String?
    state String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

enum UserType {
    COMMON
    ENTREPRENEUR
}

model Place {
    id String @id @default(uuid())
    name String @unique
    description String
    category PlaceCategory
    latitude Float
    longitude Float
    address String?
    imageUrl String?
    rating Float?
    isFree Boolean @default(false)
    openingHours String?

    // Preenchido apenas quando o local representa um evento com data marcada
    // (ex: feira, show). Nulo para locais permanentes (museu, parque etc.).
    eventDate DateTime?

    activities PlaceActivity[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("places")
}

enum PlaceCategory {
    EVENTOS
    GASTRONOMIA
    LAZER
    TURISMO
}

// Programação recorrente de um local (ex: aula de ginástica às terças).
// Diferente de Place.eventDate, que é uma data única de um evento em si.
model PlaceActivity {
    id String @id @default(uuid())
    title String
    schedule String
    imageUrl String?

    place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
    placeId String

    createdAt DateTime @default(now())

    @@map("place_activities")
}