generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id String @id @default(uuid())
    name String
    username String @unique
    email String @unique
    phone String
    password String
    type UserType @default(COMMON)

    // Preenchidos apenas para type = ENTREPRENEUR
    address String?
    addressNumber String?
    complement String?
    city String?
    state String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

enum UserType {
    COMMON
    ENTREPRENEUR
}

model Place {
    id String @id @default(uuid())
    name String @unique
    description String
    category PlaceCategory
    latitude Float
    longitude Float
    address String?
    imageUrl String?
    rating Float?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("places")
}

enum PlaceCategory {
    EVENTOS
    GASTRONOMIA
    LAZER
}